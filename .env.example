# ==============================================================================
# AI THƯ VIỆN (SMARTLIB AI) - ENVIRONMENT CONFIGURATION
# Cấu hình môi trường cho triển khai và phát triển theo đặc tả SPEC.md (Mục 14.6)
# ==============================================================================

# --- Domain & Web Security ---
PUBLIC_ORIGIN=https://smartlib.example.com
PUBLIC_HOSTNAME=smartlib.example.com
ACME_EMAIL=admin@example.com

# --- Google Gemini LLM API (Server-side key, Free Tier only) ---
GEMINI_API_KEY=your_gemini_api_key_here

# --- Storage & Directories Layout ---
SNAPSHOT_ROOT=/data/snapshots
CONTROL_ROOT=/data/control
MODEL_ROOT=/models

# --- Model & Embedding Configuration (Frozen) ---
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_REVISION=fd1525a9fd15316a2d503bf26ab031a61d056e98
LLM_MODEL=gemini-3.5-flash-lite
LLM_PROVIDER=gemini_developer
LLM_BILLING_MODE=free_only

# --- Limits, Budgets & Deadlines ---
QA_DEADLINE_SECONDS=30
QA_IP_RPM=5
QA_MAX_CONCURRENT=1
APP_CONTEXT_BUDGET=8192
OUTPUT_RESERVE=2048

# --- Google Cloud Platform Infrastructure Details ---
GCP_PROJECT_ID=
GCP_ZONE=asia-southeast1-a
GCP_PUBLIC_IP=

# --- Internal Network Ports ---
API_PORT=8000

